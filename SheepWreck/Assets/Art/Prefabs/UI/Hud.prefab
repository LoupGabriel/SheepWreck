  m_Script: {fileID: 11500000, guid: b9508c0c95554e6449c4b6de0b3ccceb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_discutionPanel: {fileID: 5615845890330753133}
  m_button: {fileID: 6192402863783760806}
  m_text: {fileID: 8879681214644176328}
  m_info:
  - I need a room to produce food! You can activate construction mode by clicking
    the hammer icon
  - You can assigned a sheep to a room by drag it in it ! Try it!
  - My crew are thirsty! Maybe we can find a way to produce water?
  - We need more gold! We can travel at another island to find some quest but before
    we need more energy to travel!
  - 'Once you reach an island you can open the island menu with the palm tree icon. '
  - 'Open the quest log with "tab". You will see your active quest. '
  - Once you accept a quest you can deliver some ressources to an island to complete
    a quest.
  m_inactiveText: Nothing to say!
  m_bubbleAnimator: {fileID: 374520763384276040}
